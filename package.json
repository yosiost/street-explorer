{
  "name": "street-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node e2e/smoke.mjs",
    "e2e:live": "node e2e/live.mjs",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/rbush": "^4.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
