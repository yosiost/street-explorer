c4059","הצבעוני":"f2d3a641c3","הצברים":"fe47f539d0","הצדק":"1bfe8b84d2","הצנחנים":"ef302847cb","הקשת":"439ea0e117","הר אדום":"dfdf2042d1","הר אדיר":"249d12c13f","הר בוקר":"3b0efd3330","הר גריזים":"4f784f24a4","הר חזון":"e53e6e7a5f","הר חריף":"3d02640f74","הר כמון":"c8605a25a5","הר כנען":"44a9282d9d","הר כרכום":"feab09a369","הר מירון":"656daa5193","הר עצמון":"121bcc43d1","הר צין":"0d3a3a6c4d","הר רביד":"0c36378eb3","הר רותם":"7ebd7155ca","הר שוקף":"28e57b432d","הר תבור":"0376c53284","הראשונים":"3a76323086","הרב גולד":"c9ed3c462f","הרב עמיאל":"0e676e0a2b","הרב קוק":"66f98f183b","הרב שמחה אסף":"bb37ef2ca1","הרבה יותר קצר מהרחוב שלנו.":"5f7e10a4b2","הרדוף":"105dccdf2c","הרחוב נקרא על שם אבא קובנר. משורר שנלחם כפרטיזן ביערות נגד הנאצים.":"cc52e8ab0b","הרחוב נקרא על שם אברהם אבן עזרא. משורר, מסביר תורה וחוקר כוכבים מספרד.":"d8a6c2b501","הרחוב נקרא על שם אברהם לינקולן. נשיא ארצות הברית ששחרר את העבדים.":"6120123188","הרחוב נקרא על שם אברהם מאפו. כתב את „אהבת ציון”, הרומן הראשון בעברית.":"3ca230f06a","הרחוב נקרא על שם אברהם שלונסקי. משורר שכתב את „עוץ לי גוץ לי”.":"06b82e0c75","הרחוב נקרא על שם אהוד מנור. כתב מילים להרבה שירים, כמו „אין לי ארץ אחרת”.":"fab58f9999","הרחוב נקרא על שם אהרן אהרונסון. מדען שגילה בארץ את „אם החיטה”, החיטה הפראית.":"d5f26a5f45","הרחוב נקרא על שם אהרן דוד גורדון. האמין שעבודה באדמה, בשדה ובגינה, טובה לאדם.":"526750d472","הרחוב נקרא על שם אחד העם. סופר שכתב בשם „אחד העם”. שמו האמיתי היה אשר גינצברג.":"3527557414","הרחוב נקרא על שם אילן רמון. טייס, והאסטרונאוט הישראלי הראשון שטס לחלל.":"19807766c7","הרחוב נקרא על שם אלברט איינשטיין. מדען גאון שגילה איך זמן, אור וכוח המשיכה עובדים.":"2a13d01009","הרחוב נקרא על שם אליהו הנביא. נביא בתנ״ך. בליל הסדר שמים לו כוס יין ופותחים לו את הדלת.":"fb9f970535","הרחוב נקרא על שם אליעזר בן־יהודה. החזיר את העברית להיות שפה שמדברים בה כל יום, וכתב מילון גדול.":"7fe5230b27","הרחוב נקרא על שם אלכסנדר ינאי. מלך מבית החשמונאים, הנכדים של המכבים.":"e7e5073e3f","הרחוב נקרא על שם אנה פרנק. ילדה יהודייה שהתחבאה מהנאצים וכתבה יומן שכל העולם קורא.":"824bd5f5dd","הרחוב נקרא על שם ארתור רופין. עזר להקים הרבה יישובים, כמו דגניה ותל אביב.":"0440880b95","הרחוב נקרא על שם בנימין זאב (תאודור) הרצל. חלם שיהיה לעם היהודי מדינה, הרבה לפני שהייתה.":"083e7cf034","הרחוב נקרא על שם בר כוכבא. מנהיג שמרד נגד הרומאים לפני כמעט 1,900 שנה.":"90c9808e7c","הרחוב נקרא על שם גדעון. שופט בתנ״ך שניצח עם 300 לוחמים, שופרות וכדים.":"0304686e1e","הרחוב נקרא על שם גולדה מאיר. האישה הראשונה שהייתה ראש ממשלה בישראל.":"37f0ee59e1","הרחוב נקרא על שם ג׳ורג׳ וושינגטון. הנשיא הראשון של ארצות הברית.":"fed3967126","הרחוב נקרא על שם דבורה הנביאה. נביאה ושופטת בתנ״ך, שישבה מתחת לעץ תמר ושפטה את העם.":"5f992cb442","הרחוב נקרא על שם דוד אלעזר („דדו”). הרמטכ״ל בזמן מלחמת יום הכיפורים.":"fc65cce28f","הרחוב נקרא על שם דוד בן־גוריון. ראש הממשלה הראשון. הוא הכריז על הקמת מדינת ישראל.":"09fc4ded23","הרחוב נקרא על שם דוד המלך. הנער שניצח את גוליית הענק עם קלע, ואחר כך היה מלך.":"08d5ccbd78","הרחוב נקרא על שם דון יצחק אברבנאל. שר האוצר של מלך ספרד, שבחר לצאת עם היהודים כשגורשו ב־1492.":"9559bd2a8e","הרחוב נקרא על שם דניאל. גיבור בתנ״ך שנזרק לגוב האריות, והאריות לא פגעו בו.":"6c31c9c65a","הרחוב נקרא על שם הארי טרומן. נשיא ארצות הברית. הוא הכיר במדינת ישראל דקות אחרי שקמה.":"44f7825252","הרחוב נקרא על שם הברון אדמונד דה רוטשילד. עזר להקים הרבה מושבות בארץ, וקראו לו „הנדיב הידוע”.":"4258d86f67","הרחוב נקרא על שם היינריך גרץ. היסטוריון שכתב את כל ההיסטוריה של העם היהודי.":"c8d3d0ea0b","הרחוב נקרא על שם הלל הזקן. חכם סבלני שלימד את כל התורה „על רגל אחת”.":"b409d528a7","הרחוב נקרא על שם הנסיכה גרייס. שחקנית קולנוע אמריקאית שהתחתנה עם נסיך מונקו.":"252488d8a4","הרחוב נקרא על שם הנרי הדסון. ימאי וחוקר שהפליג במעלה הנהר שקרוי היום על שמו.":"2efadc42e2","הרחוב נקרא על שם הנרייטה סולד. ייסדה את „הדסה” ועזרה להביא לארץ ולהציל אלפי ילדים.":"959fa92648","הרחוב נקרא על שם הרב אברהם יצחק הכהן קוק. הרב הראשי האשכנזי הראשון בארץ ישראל.":"282755b3c4","הרחוב נקרא על שם הרב יהודה אלקלעי. רב שקרא לחזור לארץ ישראל עוד לפני הרצל.":"f153c2d26c","הרחוב נקרא על שם הרב מאיר בר־אילן. רב ומנהיג ציוני. אוניברסיטת בר־אילן נקראת על שמו.":"54508217a5","הרחוב נקרא על שם הרב צבי הירש קלישר. רב שקרא לחזור לארץ ישראל עוד לפני הרצל.":"4cb848cd08","הרחוב נקרא על שם הרמב״ם (רבי משה בן מימון). רב, פילוסוף ורופא חשוב, שחי לפני יותר מ־800 שנה.":"99d48a5bf9","הרחוב נקרא על שם וולפגנג אמדאוס מוצרט. מלחין שהתחיל לכתוב מוזיקה כשהיה ילד קטן.":"ab8203ce60","הרחוב נקרא על שם ויליאם שייקספיר. הכותב המפורסם ביותר של מחזות בשפה האנגלית.":"5fd62823e9","הרחוב נקרא על שם זאב ז׳בוטינסקי. מנהיג ציוני, סופר ומשורר, שכתב בהרבה שפות.":"f4ef04ea99","הרחוב נקרא על שם חביבה רייך. צנחנית אמיצה שצנחה באירופה כדי לעזור ליהודים במלחמה.":"dea720c361","הרחוב נקרא על שם חיים ויצמן. הנשיא הראשון של מדינת ישראל. הוא היה גם מדען, כימאי.":"0bac2ca702","הרחוב נקרא על שם חיים נחמן ביאליק. „המשורר הלאומי”. כתב גם הרבה שירים לילדים, כמו „שבת המלכה”.":"617618eee2","הרחוב נקרא על שם חנה סנש. משוררת וצנחנית אמיצה. כתבה את השיר „הליכה לקיסריה” (אלי, אלי).":"b267e8d1cd","הרחוב נקרא על שם יאיר רוזנבלום. מלחין שכתב את המנגינה של „שיר לשלום”.":"1d94878760","הרחוב נקרא על שם יאנוש קורצ׳אק. רופא ומורה שדאג לילדים יתומים בוורשה ולא עזב אותם אף פעם.":"5b73f6d80b","הרחוב נקרא על שם יגאל ידין. רמטכ״ל וארכיאולוג, שחפר במצדה ומצא שם אוצרות עתיקים.":"2a4afe55cd","הרחוב נקרא על שם יהודה המכבי. מנהיג המכבים, הגיבור של סיפור חנוכה.":"d699341480","הרחוב נקרא על שם יוסף חיים ברנר. סופר עברי שכתב על החיים בארץ לפני יותר ממאה שנה.":"918241b7e1","הרחוב נקרא על שם יוסף טרומפלדור. גיבור שהגן על תל חי בגליל.":"d86267d5e9","הרחוב נקרא על שם יוסף שפרינצק. יושב ראש הכנסת הראשון.":"7e555637ed","הרחוב נקרא על שם יחזקאל הנביא. נביא שראה בחזון עצמות יבשות שחוזרות לחיים.":"6dd9503030","הרחוב נקרא על שם יצחק בן־צבי. הנשיא השני של מדינת ישראל.":"2d226af626","הרחוב נקרא על שם יצחק לייבוש פרץ. סופר שכתב סיפורים ביידיש ובעברית.":"418247790c","הרחוב נקרא על שם יצחק רבין. רמטכ״ל וראש ממשלה, שזכה בפרס נובל לשלום.":"c6242a59fd","הרחוב נקרא על שם ישעיהו הנביא. נביא שחלם על עולם בלי מלחמות, שבו גר זאב עם כבש.":"4229133721","הרחוב נקרא על שם כריסטופר קולומבוס. ימאי שהפליג מעבר לים הגדול והגיע לאמריקה.":"9a302257bd","הרחוב נקרא על שם לאה גולדברג. משוררת שכתבה ספרים לילדים, כמו „דירה להשכיר” ו„איה פלוטו”.":"6a15b99d82","הרחוב נקרא על שם לודוויג זמנהוף. רופא עיניים שהמציא שפה חדשה לכל העולם: אספרנטו.":"9496affaec","הרחוב נקרא על שם לוי אשכול. ראש הממשלה השלישי של ישראל.":"ff92a83746","הרחוב נקרא על שם לורד ארתור בלפור. שר בריטי שהבטיח ב־1917 בית לאומי לעם היהודי בארץ ישראל.":"3485cda062","הרחוב נקרא על שם מאיר דיזנגוף. ראש העיר הראשון של תל אביב.":"b2dc6a4312","הרחוב נקרא על שם מוטה גור. מפקד הצנחנים במלחמת ששת הימים, שכתב גם ספרים לילדים על „עזית הכלבה הצנחנית”.":"392718361b","הרחוב נקרא על שם מנחם בגין. ראש ממשלה שעשה שלום עם מצרים וזכה בפרס נובל לשלום.":"144dfa5c7a","הרחוב נקרא על שם מקס נורדאו. רופא וסופר, חבר של הרצל, שעזר לו להקים את התנועה הציונית.":"ec628e957e","הרחוב נקרא על שם מרדכי אנילביץ׳. המפקד של מרד גטו ורשה, שנלחם נגד הנאצים.":"9fdbd061b1","הרחוב נקרא על שם מרטין לותר קינג. נלחם בלי אלימות כדי שכל האנשים יקבלו אותן זכויות.":"8004d33d02","הרחוב נקרא על שם משה דיין. רמטכ״ל ושר ביטחון, שהיה לו כיסוי על עין אחת.":"f33cd98162","הרחוב נקרא על שם משה שרת. שר החוץ הראשון של ישראל, ואחר כך ראש הממשלה השני.":"05043307b1","הרחוב נקרא על שם נחום סוקולוב. עיתונאי ומנהיג ציוני. הוא נתן לעיר תל אביב את השם שלה.":"276acf8abd","הרחוב נקרא על שם נחמיה. בנה מחדש את החומות של ירושלים.":"bf4327be8e","הרחוב נקרא על שם נעמי שמר. כתבה והלחינה הרבה שירים, כמו „ירושלים של זהב”.":"ad7a066a2b","הרחוב נקרא על שם נפתלי הרץ אימבר. כתב את המילים של „התקווה”, ההמנון של ישראל.":"18ce56976f","הרחוב נקרא על שם נתן אלתרמן. משורר שכתב הרבה שירים ופזמונים, וגם ספרים לילדים.":"22e92cc0c8","הרחוב נקרא על שם סשה ארגוב. מלחין שכתב מנגינות להרבה שירים ישראליים.":"b4a6f9df35","הרחוב נקרא על שם עוזי חיטמן. כתב והלחין הרבה שירים, כמו „כאן”, וגם שירים לילדים.":"0434324da4","הרחוב נקרא על שם עוזי נרקיס. אלוף שפיקד על הקרבות בירושלים במלחמת ששת הימים.":"e2f81eda28","הרחוב נקרא על שם עמוס הנביא. רועה צאן שהיה לנביא, ודרש לעזור לעניים.":"767bfeb023","הרחוב נקרא על שם עמנואל רינגלבלום. אסף והחביא מכתבים ומסמכים בגטו ורשה, כדי שהסיפור יישמר.":"64286c8850","הרחוב נקרא על שם עפרה חזה. זמרת ישראלית שהשירים שלה התפרסמו בכל העולם.":"6d61b48439","הרחוב נקרא על שם צביה לובטקין. מהמנהיגות של מרד גטו ורשה נגד הנאצים.":"9b047d5015","הרחוב נקרא על שם רבי יהודה הלוי. משורר מספרד, לפני כמעט אלף שנה, שכתב „ליבי במזרח”.":"ff959a5722","הרחוב נקרא על שם רבי יהודה הנשיא. אסף וסידר את המשנה, ספר חשוב מאוד.":"4f627c715d","הרחוב נקרא על שם רבי יוחנן הסנדלר. חכם מימי המשנה, שעבד בתיקון נעליים.":"d6b5fda47b","הרחוב נקרא על שם רבי עקיבא. חכם שלימד: „ואהבת לרעך כמוך” זה הכלל הכי חשוב בתורה.":"d53eb4a07a","הרחוב נקרא על שם רחל המשוררת. משוררת שכתבה שירים על הכנרת, האגם שאהבה.":"65a55aebe3","הרחוב נקרא על שם רש״י (רבי שלמה יצחקי). כתב הסברים לתורה ולתלמוד שלומדים עד היום.":"02699ecb87","הרחוב נקרא על שם שאול המלך. המלך הראשון של עם ישראל.":"2b638a0bff","הרחוב נקרא על שם שאול טשרניחובסקי. משורר שהיה גם רופא.":"5fb61cd403","הרחוב נקרא על שם שלום עליכם. סופר שכתב ביידיש סיפורים מצחיקים, כמו „טוביה החולב”.":"b2a1b60117","הרחוב נקרא על שם שלמה אבן גבירול. משורר מספרד שחי לפני כמעט אלף שנה.":"6c8274faf5","הרחוב נקרא על שם שלמה המלך. הבן של דוד, מלך חכם מאוד שבנה את בית המקדש הראשון.":"94903507e2","הרחוב נקרא על שם ש״י עגנון. סופר שזכה בפרס נובל לספרות, הישראלי הראשון שזכה בו.":"6f7da24479","הרימון":"8fa2633bf0","הרמה":"3ed6b06d39","הרעות":"61f03fde12","הרצל":"123eafc2a5","הרקפת":"5cf1e6913d","השדרה":"f87d2bf992","השומר":"54f4571d56","השופטים":"b9ebc88c56","השחר":"146cb08a5d","השילוני":"54738063c4","השלום":"76a0f9c0cc","השמחה":"f7cd9622c9","השפלה":"ee6d7f59f5","השקדים":"5afdbecd36","השרון":"6d322baede","התאנה":"1e2b0354c7","התוכנה":"9078d2d16e","התותחנים":"6d38bf64a6","התחיה":"f2de9bc540","התחנה":"0ed515eb09","התנאים":"27d6654512","התע״ש":"eca5147dc0","התפוז":"f937b23a6d","וזה הרחוב שלנו!":"5e55f3fefb","ויצמן":"dce94d36ec","ויתקין":"6322e919df","זאב בלפר":"7f26cdb2eb","זאב גלר":"b7a17d3cd6","זה":"081376f203","זטלר":"76